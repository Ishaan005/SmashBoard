{
  "name": "smashboard",
  "version": "0.1.1",
  "description": "The Ultimate Badminton Club Manager - Track players, manage matches, courts, and calculate ELO ratings",
  "author": "SmashBoard Team",
  "private": true,
  "main": "dist/electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev --turbopack",
    "dev:electron": "npm run rebuild:native && wait-on http://localhost:3000 && electron .",
    "build": "npm run build:next && npm run build:electron",
    "build:next": "next build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "clean": "rm -rf out dist release .next node_modules/.cache",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dist": "npm run build && npm run rebuild:native && electron-builder",
    "dist:win": "npm run build && npm run rebuild:native && electron-builder --win",
    "dist:mac": "npm run build && npm run rebuild:native && electron-builder --mac",
    "dist:linux": "npm run build && npm run rebuild:native && electron-builder --linux",
    "dist:all": "npm run build && npm run rebuild:native && electron-builder --mac --win --linux",
    "seed": "ts-node db/seed.ts",
    "test": "npm run rebuild:node && jest",
    "test:watch": "jest --watch",
    "lint": "next lint",
    "postinstall": "electron-builder install-app-deps && electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.3",
    "@dnd-kit/sortable": "^7.0.0",
    "@dnd-kit/utilities": "^3.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.4.1",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.1.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jest": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "wait-on": "^9.0.1",
    "webpack": "^5.101.3"
  },
  "build": {
    "appId": "com.smashboard.app",
    "productName": "SmashBoard",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "electronVersion": "38.2.0",
    "files": [
      "dist/**/*",
      "out/**/*",
      "debug.html",
      "package.json",
      "!node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmashBoard"
    }
  }
}
